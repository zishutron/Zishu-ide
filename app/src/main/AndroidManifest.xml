<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to start cloud builds on GitHub and to download the finished APK. Nothing else uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed only for the "Install" button on a finished APK (Android asks the user to allow it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Only used if the user turns on "Phone storage" in Settings, so projects appear in the ZishuIDE folder
         that file managers can see. Android 11+ asks via the "All files access" switch. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:name=".app.App"
        android:allowBackup="false"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@drawable/zishu_launcher"
        android:roundIcon="@drawable/zishu_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zishu.Light"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".app.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Zishu.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".app.NewProjectActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.EditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.BuildActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".app.SdkActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false" />

        <activity
            android:name=".app.CloudSettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false" />

        <!-- Serves finished APKs to the system installer. Not exported; access is granted per Intent. -->
        <provider
            android:name=".app.ApkProvider"
            android:authorities="com.zishu.ide.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
